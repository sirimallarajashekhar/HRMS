root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# Test names follow Method_Scenario_ExpectedResult
dotnet_diagnostic.CA1707.severity = none

[**/Persistence/Migrations/*.cs]
# EF-generated: regenerated by `dotnet ef`, so analyzers skip it. Hand-written code stays fully checked.
generated_code = true
