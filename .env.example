# Local development only. Copy to .env (git-ignored) and change anything you like.
# Never reuse these values outside your machine.
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=hrms
MYSQL_USER=hrms
MYSQL_PASSWORD=dev-hrms-password
REDIS_PASSWORD=dev-redis-password
RABBITMQ_USER=hrms
RABBITMQ_PASSWORD=dev-rabbit-password
OBJECTSTORE_ACCESS_KEY=hrmsstore
OBJECTSTORE_SECRET_KEY=dev-objectstore-secret

# Host ports. Change any that clash with something already running on your machine.
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
OBJECTSTORE_PORT=9000
OBJECTSTORE_CONSOLE_PORT=9001
SEQ_INGEST_PORT=5341
SEQ_UI_PORT=8081
API_PORT=8080
